# README demo, dark render. Run `just demo`; assets/demo.tape is the shared body.
Output assets/demo-dark.gif
Set Theme { "name": "ordo-dark", "background": "#1a1b26", "foreground": "#c0caf5", "cursor": "#c0caf5", "selection": "#33467c", "black": "#15161e", "red": "#f7768e", "green": "#9ece6a", "yellow": "#e0af68", "blue": "#7aa2f7", "magenta": "#bb9af7", "cyan": "#73daca", "white": "#a9b1d6", "brightBlack": "#565f89", "brightRed": "#ff899d", "brightGreen": "#afd67a", "brightYellow": "#ffc777", "brightBlue": "#8db0ff", "brightMagenta": "#c7a9ff", "brightCyan": "#7fe4d2", "brightWhite": "#c0caf5" }
Set MarginFill "#0d1117"
Source assets/demo.tape
