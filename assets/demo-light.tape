# README demo, light render. Run `just demo`; assets/demo.tape is the shared body.
Output assets/demo-light.gif
Set Theme { "name": "phasionary-light", "background": "#eff1f5", "foreground": "#4c4f69", "cursor": "#4c4f69", "selection": "#acb0be", "black": "#11111b", "red": "#d20f39", "green": "#40a02b", "yellow": "#f4bf4f", "blue": "#1e66f5", "magenta": "#8839ef", "cyan": "#179299", "white": "#5c5f77", "brightBlack": "#6c6f85", "brightRed": "#de293e", "brightGreen": "#49af3d", "brightYellow": "#eea02d", "brightBlue": "#456eff", "brightMagenta": "#fe85d8", "brightCyan": "#2d9fa8", "brightWhite": "#bcc0cc" }
Set MarginFill "#ffffff"
Source assets/demo.tape
