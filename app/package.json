{
	"name": "ordo-app",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"format": "prettier --check .",
		"format:write": "prettier --write .",
		"android:sync": "BUILD_TARGET=app vite build && cap sync android",
		"android:install": "bun run android:sync && cd android && ./gradlew installDebug"
	},
	"devDependencies": {
		"@capacitor/android": "8.5.3",
		"@capacitor/cli": "8.5.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"fake-indexeddb": "^6.2.5",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@capacitor/app": "^8",
		"@capacitor/core": "8.5.3",
		"bits-ui": "^2.18.2",
		"idb": "^8.0.3",
		"jsqr": "^1.4.0",
		"vaul-svelte": "1.0.0-next.7"
	}
}
